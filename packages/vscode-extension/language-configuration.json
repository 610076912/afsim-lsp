{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["{", "}"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "/*", "close": " */" }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "(", "close": ")" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(platform_type|platform|sensor|processor|comm|mover|fuel|router|network|route|zone|transmitter|receiver|mode|behavior_tree|state|group|script|on_initialize|on_initialize2|on_update|on_entry|on_exit|on_message|on_init|precondition|execute|script_variables|event_pipe|console_output)\\b",
      "end": "^\\s*end_(platform_type|platform|sensor|processor|comm|mover|fuel|router|network|route|zone|transmitter|receiver|mode|behavior_tree|state|group|script|on_initialize|on_initialize2|on_update|on_entry|on_exit|on_message|on_init|precondition|execute|script_variables|event_pipe|console_output)\\b"
    }
  }
}
