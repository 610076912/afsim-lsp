{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 AFSIM LSP 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "--disable-extensions",
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "编译扩展",
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
